<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>Checkpoint</AssemblyName>
    <RootNamespace>ListaJuegos.App</RootNamespace>
    <Product>Checkpoint</Product>
    <AssemblyTitle>Checkpoint</AssemblyTitle>
    <Description>Crea y edita listas de juegos en .txt y .md</Description>
    <Version>1.2.0</Version>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <SatelliteResourceLanguages>es</SatelliteResourceLanguages>
    <!-- Program.Main decide entre las órdenes de consola (add, complete, stats, help) y la ventana antes de iniciar WPF -->
    <StartupObject>ListaJuegos.App.Program</StartupObject>
  </PropertyGroup>

  <!-- Publicación: un único .exe que no necesita instalar .NET -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ListaJuegos.Core\ListaJuegos.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>

  <!-- La interfaz (HTML/CSS/JS, fuentes e iconos) va dentro del .exe y se sirve en https://app.lj/ -->
  <ItemGroup>
    <EmbeddedResource Include="ui\**\*" Exclude="ui\mock\**;ui\.taste-skill\**" LogicalName="ui/%(RecursiveDir)%(Filename)%(Extension)" />
    <None Remove="ui\**" />
    <Resource Include="app.ico" />
  </ItemGroup>

</Project>
